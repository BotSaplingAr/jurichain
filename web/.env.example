# Salin menjadi `.env.local`, isi, lalu jalankan ulang `npm run dev`.

# Jaringan: "local" = node Hardhat (http://127.0.0.1:8545, chainId 31337)
#           kosong / "baseSepolia" = Base Sepolia (chainId 84532)
NEXT_PUBLIC_CHAIN=local

# Alamat kontrak JuriChain (dicetak oleh `npm run deploy:local` / `npm run deploy:base-sepolia` di root)
NEXT_PUBLIC_JURICHAIN_ADDRESS=

# Opsional: RPC Base Sepolia khusus (default: https://sepolia.base.org)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
