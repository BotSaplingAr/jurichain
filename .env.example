# Salin file ini menjadi `.env` lalu isi nilainya. File .env TIDAK ikut di-commit.
#
# PENTING: pakai dompet KHUSUS TESTNET yang hanya berisi ETH Base Sepolia.
# Jangan pernah memakai private key dompet yang menyimpan aset sungguhan.

# Private key dompet deployer (format 0x...)
PRIVATE_KEY=

# RPC Base Sepolia (default publik; bisa diganti RPC Alchemy/Infura/QuickNode)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Opsional: verifikasi kontrak di Basescan.
# Buat API key gratis di https://etherscan.io/myapikey (Etherscan API V2, berlaku juga untuk Base Sepolia).
BASESCAN_API_KEY=
